# Development settings (copy this file to .env and edit as needed)

# Basic key-value pairs
APP_NAME=myapp
APP_ENV=development
APP_PORT=8000

# Variable expansion: use ${VAR} syntax
DOMAIN=example.org
ADMIN_EMAIL=admin@${DOMAIN}
BASE_URL=${DOMAIN}/${APP_NAME}

# Quoted string value
GREETING="Hello, World!"

# Export prefix (does not affect interpretation)
export DB_PASSWORD=s3cret

# Empty value
SESSION_SECRET=

# Value with spaces inside quotes
FULL_TITLE="My Awesome Application"
